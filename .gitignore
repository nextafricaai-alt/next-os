# ─── NEXT OS .gitignore ────────────────────────────────────────────────
# What NOT to push to GitHub

# Node / npm
node_modules/
package-lock.json.bak
npm-debug.log*

# Cloudflare Wrangler local caches + local secrets
.wrangler/
.dev.vars
.dev.vars.*
wrangler.toml.bak

# Environment files (NEVER commit these — they contain secrets)
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa
id_rsa.*

# OS junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Editor / IDE
.vscode/
.idea/
*.sublime-*

# Build outputs / caches (none currently, future-proof)
dist/
build/
.cache/

# Personal scratch / experiments
scratch/
*.tmp

.dev.vars*
!.dev.vars.example
!.env.example

# ─── Personal data — never commit (audit C7) ─────────────────────────
# Real pupil/staff/fee exports, login lists and seed SQL built from them.
# Keep them in C:\Users\PC\Desktop\patrick\next-os-PRIVATE-DATA (outside the repo).
kabs_lily_*.csv
*kabs*lily*.csv
teacher-logins-*.csv
*.NEW-PASSWORDS.csv
*students*.csv
*fees*.csv
*teachers*.csv
supabase-*kabs*lily*.sql
*kabslily*.sql
supabase-seed-12-teachers-pdf.sql
WhatsApp Image *.jpeg
WhatsApp Image *.jpg
sentinel/data/*.db
sentinel/data/*.db-wal
sentinel/data/*.db-shm
sentinel/data/.fuse_hidden*
private-data/
