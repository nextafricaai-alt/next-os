{
  "name": "next-os-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Local dev/QA harness for NEXT OS frontend — JSX syntax checks, DOM checks, screenshot capture.",
  "scripts": {
    "serve": "npx --yes http-server .. -p 8085 -c-1 --cors",
    "check:jsx": "node check_jsx.js",
    "check:dom": "node check_dom.js",
    "screenshot": "node take_screenshot.js"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "puppeteer": "^25.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
