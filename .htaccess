RewriteEngine On
RewriteRule ^s/([A-Za-z0-9_-]+)/?$ prototypes/schools/peak-primary/login.html?s=$1 [L,QSA]
RewriteRule ^school/([A-Za-z0-9_-]+)/?$ prototypes/schools/peak-primary/index.html?s=$1 [L,QSA]

# Never cache the service worker — it must update immediately so push handlers stay current.
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </IfModule>
</Files>
