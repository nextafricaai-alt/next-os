RewriteEngine On
RewriteRule ^s/([A-Za-z0-9_-]+)/?$ school.php?s=$1&login=1 [L,QSA]
RewriteRule ^school/([A-Za-z0-9_-]+)/login/?$ school.php?s=$1&login=1 [L,QSA]
RewriteRule ^school/([A-Za-z0-9_-]+)/?$ school.php?s=$1 [L,QSA]

# Service worker must always be fresh.
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </IfModule>
</Files>

# Never serve a stale app shell — HTML must revalidate every load so deploys land immediately.
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Tell LiteSpeed not to full-page-cache the HTML.
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule \.html$ - [E=Cache-Control:no-cache]
  RewriteRule ^$ - [E=Cache-Control:no-cache]
  RewriteRule ^(s|school)/ - [E=Cache-Control:no-cache]
</IfModule>
